{
  "name": "cardsmith",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "npm run copy-wasm",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && node scripts/copy-wasm.js",
    "copy-wasm": "node scripts/copy-wasm.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.48.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.7",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0"
  }
}
